<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NalaApps Utility Design System v3.0. Legacy keys are preserved for compatibility. -->

    <!-- Brand and semantic colors. -->
    <Color x:Key="NalaBlue">#2452D6</Color>
    <Color x:Key="NalaBluePressed">#173BAA</Color>
    <Color x:Key="NalaRed">#C9363E</Color>
    <Color x:Key="NalaBackground">#F6F8FC</Color>
    <Color x:Key="NalaSurface">#FFFFFF</Color>
    <Color x:Key="NalaText">#253858</Color>
    <Color x:Key="NalaSubText">#607087</Color>
    <Color x:Key="NalaLine">#D5DFED</Color>
    <Color x:Key="NalaSoft">#F1F4F9</Color>

    <Color x:Key="NalaApps.Color.Primary">#2452D6</Color>
    <Color x:Key="NalaApps.Color.PrimaryHover">#1F47C4</Color>
    <Color x:Key="NalaApps.Color.PrimaryPressed">#173BAA</Color>
    <Color x:Key="NalaApps.Color.AccentViolet">#6539D6</Color>
    <Color x:Key="NalaApps.Color.AccentCyan">#0F749E</Color>
    <Color x:Key="NalaApps.Color.Success">#176B50</Color>
    <Color x:Key="NalaApps.Color.Warning">#9A5B00</Color>
    <Color x:Key="NalaApps.Color.Danger">#C9363E</Color>
    <Color x:Key="NalaApps.Color.AppBackground">#F4F7FC</Color>
    <Color x:Key="NalaApps.Color.Sidebar">#FBFCFF</Color>
    <Color x:Key="NalaApps.Color.Surface">#FFFFFF</Color>
    <Color x:Key="NalaApps.Color.SurfaceSoft">#F6F8FC</Color>
    <Color x:Key="NalaApps.Color.SurfaceHover">#EEF3FA</Color>
    <Color x:Key="NalaApps.Color.SurfaceSelected">#EAF0FF</Color>
    <Color x:Key="NalaApps.Color.TextStrong">#0B214A</Color>
    <Color x:Key="NalaApps.Color.Text">#31445F</Color>
    <Color x:Key="NalaApps.Color.TextMuted">#607087</Color>
    <Color x:Key="NalaApps.Color.Border">#D8E1EF</Color>
    <Color x:Key="NalaApps.Color.BorderStrong">#B7C5DA</Color>
    <Color x:Key="NalaApps.Color.Focus">#7CA3FF</Color>
    <Color x:Key="NalaApps.Color.OnPrimary">#FFFFFF</Color>
    <Color x:Key="NalaApps.Color.OnDanger">#FFFFFF</Color>

    <!-- Legacy brushes. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource NalaBlue}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource NalaBluePressed}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource NalaRed}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource NalaBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource NalaSurface}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource NalaText}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource NalaSubText}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource NalaLine}" />
    <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource NalaSoft}" />

    <!-- Namespaced brushes. -->
    <SolidColorBrush x:Key="NalaApps.Brush.Primary" Color="{StaticResource NalaApps.Color.Primary}" />
    <SolidColorBrush x:Key="NalaApps.Brush.PrimaryHover" Color="{StaticResource NalaApps.Color.PrimaryHover}" />
    <SolidColorBrush x:Key="NalaApps.Brush.PrimaryPressed" Color="{StaticResource NalaApps.Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="NalaApps.Brush.AccentViolet" Color="{StaticResource NalaApps.Color.AccentViolet}" />
    <SolidColorBrush x:Key="NalaApps.Brush.AccentCyan" Color="{StaticResource NalaApps.Color.AccentCyan}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Success" Color="{StaticResource NalaApps.Color.Success}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Warning" Color="{StaticResource NalaApps.Color.Warning}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Danger" Color="{StaticResource NalaApps.Color.Danger}" />
    <SolidColorBrush x:Key="NalaApps.Brush.AppBackground" Color="{StaticResource NalaApps.Color.AppBackground}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Sidebar" Color="{StaticResource NalaApps.Color.Sidebar}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Surface" Color="{StaticResource NalaApps.Color.Surface}" />
    <SolidColorBrush x:Key="NalaApps.Brush.SurfaceSoft" Color="{StaticResource NalaApps.Color.SurfaceSoft}" />
    <SolidColorBrush x:Key="NalaApps.Brush.SurfaceHover" Color="{StaticResource NalaApps.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="NalaApps.Brush.SurfaceSelected" Color="{StaticResource NalaApps.Color.SurfaceSelected}" />
    <SolidColorBrush x:Key="NalaApps.Brush.TextStrong" Color="{StaticResource NalaApps.Color.TextStrong}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Text" Color="{StaticResource NalaApps.Color.Text}" />
    <SolidColorBrush x:Key="NalaApps.Brush.TextMuted" Color="{StaticResource NalaApps.Color.TextMuted}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Border" Color="{StaticResource NalaApps.Color.Border}" />
    <SolidColorBrush x:Key="NalaApps.Brush.BorderStrong" Color="{StaticResource NalaApps.Color.BorderStrong}" />
    <SolidColorBrush x:Key="NalaApps.Brush.Focus" Color="{StaticResource NalaApps.Color.Focus}" />
    <SolidColorBrush x:Key="NalaApps.Brush.OnPrimary" Color="{StaticResource NalaApps.Color.OnPrimary}" />
    <SolidColorBrush x:Key="NalaApps.Brush.OnDanger" Color="{StaticResource NalaApps.Color.OnDanger}" />

    <LinearGradientBrush x:Key="NalaApps.Brush.PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource NalaApps.Color.Primary}" Offset="0" />
        <GradientStop Color="#5146CE" Offset="0.52" />
        <GradientStop Color="{StaticResource NalaApps.Color.AccentViolet}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NalaApps.Brush.AppBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2F6FD" Offset="0" />
        <GradientStop Color="#F8FAFE" Offset="0.52" />
        <GradientStop Color="#F5F1FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NalaApps.Brush.BrandSoftGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F9FF" Offset="0" />
        <GradientStop Color="#F3F0FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NalaApps.Brush.ElevatedSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FBFCFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NalaApps.Brush.PanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7F9FF" Offset="0.58" />
        <GradientStop Color="#F3F1FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NalaApps.Brush.ControlGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAFBFE" Offset="0.46" />
        <GradientStop Color="#F0F4FA" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="38" ShadowDepth="5" Opacity="0.13" Color="#1A2C4D" />
    <DropShadowEffect x:Key="NalaApps.Effect.PanelShadow" BlurRadius="48" ShadowDepth="7" Opacity="0.15" Color="#1A2C4D" />
    <DropShadowEffect x:Key="NalaApps.Effect.ItemShadow" BlurRadius="22" ShadowDepth="3" Opacity="0.11" Color="#263B61" />
    <DropShadowEffect x:Key="NalaApps.Effect.ControlShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="#2A4067" />
    <DropShadowEffect x:Key="NalaApps.Effect.ButtonShadow" BlurRadius="32" ShadowDepth="6" Opacity="0.34" Color="#244DCB" />
    <DropShadowEffect x:Key="NalaApps.Effect.HeroShadow" BlurRadius="58" ShadowDepth="10" Opacity="0.20" Color="#1C3158" />
    <DropShadowEffect x:Key="NalaApps.Effect.FloatingShadow" BlurRadius="42" ShadowDepth="8" Opacity="0.16" Color="#162A4A" />
    <DropShadowEffect x:Key="NalaApps.Effect.ActionBarShadow" BlurRadius="50" ShadowDepth="9" Opacity="0.17" Color="#162A4A" />

    <FontFamily x:Key="NalaFontFamily">Pretendard, Segoe UI Variable, Segoe UI, Malgun Gothic</FontFamily>

    <CornerRadius x:Key="NalaApps.Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="NalaApps.Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="NalaApps.Radius.Item">11</CornerRadius>
    <CornerRadius x:Key="NalaApps.Radius.Pill">7</CornerRadius>

    <Thickness x:Key="NalaApps.Space.4">4</Thickness>
    <Thickness x:Key="NalaApps.Space.8">8</Thickness>
    <Thickness x:Key="NalaApps.Space.12">12</Thickness>
    <Thickness x:Key="NalaApps.Space.16">16</Thickness>
    <Thickness x:Key="NalaApps.Space.20">20</Thickness>
    <Thickness x:Key="NalaApps.Space.24">24</Thickness>
    <Thickness x:Key="NalaApps.Space.32">32</Thickness>
    <Thickness x:Key="NalaApps.Space.40">40</Thickness>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
    </Style>

    <Style x:Key="NalaCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NalaApps.Brush.ElevatedSurfaceGradient}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="NalaButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SoftBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="NalaColoredButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="12"
                Padding="{TemplateBinding Padding}"
                Effect="{StaticResource NalaApps.Effect.ButtonShadow}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="#FFFFFF" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.94" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button" BasedOn="{StaticResource NalaButtonBase}" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NalaButtonBase}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource NalaApps.Brush.PrimaryGradient}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource NalaColoredButtonTemplate}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NalaButtonBase}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Template" Value="{StaticResource NalaColoredButtonTemplate}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource NalaButtonBase}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="42" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{DynamicResource NalaApps.FontFamily}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemRoot"
                            Background="{StaticResource SoftBrush}"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="#EAF0FF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="#EEF2F8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
